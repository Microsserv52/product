# Local Compose configuration. Copy to .env; never commit the real .env file.
PRODUCT_IMAGE=microsserv52-product:local

# Shared HS256 secret. The local identity mock signs tokens with this value.
JWT_SECRET=replace-with-at-least-32-random-characters

# Local PostgreSQL.
PRODUCT_DB_NAME=product
PRODUCT_DB_USER=product
PRODUCT_DB_PASSWORD=product
PRODUCT_DB_PORT=5432

# Local Redis. Caching is disabled by default until it is verified in the target
# environment. Set CACHE_ENABLED=true to exercise the cache locally.
PRODUCT_REDIS_PORT=6379
CACHE_ENABLED=false
CACHE_TTL_SECONDS=60

# Published host ports.
PRODUCT_PORT=8080
PRODUCT_IDENTITY_PORT=8081

# Local image blob storage. The image-storage mock runs alongside this stack;
# set PRODUCT_IMAGE_MODE=s3 with PRODUCT_IMAGE_S3_BUCKET/REGION/MEDIA_ORIGIN for AWS S3.
PRODUCT_IMAGE_MODE=mock
PRODUCT_IMAGE_STORAGE_URL=http://image-storage:8090
PRODUCT_IMAGE_STORAGE_PORT=8090

LOG_LEVEL=INFO
HEALTH_DETAILS=always
